<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 现代车座舱（B 版）为单一暗色定稿，窗口底色直接对齐应用背景，避免启动时闪白 -->
    <style name="Theme.CarMaintenance" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/cockpit_background</item>
        <item name="android:statusBarColor">@color/cockpit_background</item>
        <item name="android:navigationBarColor">@color/cockpit_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
